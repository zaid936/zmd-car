<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Granted only by the PC script (adb pm grant): lets the hub switch its own
         accessibility service back on, since BYD screens hide that settings page. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14: a foreground service must declare its type (HubService = specialUse). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Android 12+: needed to see Bluetooth phones connect (asked in the setup screen). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the "التشغيل بالخلفية" button can show the direct allow-in-background dialog (Perms.kt). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- To fully close CarPlay / Android Auto (DiPlay / DiAuto) after the phone is unplugged. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- ZMD Car and ZMD Auto (our Android Auto, same signing key) talk only through this: ZMD Auto
         reports its connection stages, and only ZMD Car may open its private screens. Both apps
         define it, so it works whichever of the two is installed first. -->
    <permission
        android:name="com.zmd.carhub.permission.AUTO_LINK"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.zmd.carhub.permission.AUTO_LINK" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic is on only so the store can be tested on a private network;
         Net.kt refuses plain http to anything that is not a private/local address. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/HubTheme"
        android:usesCleartextTraffic="true">

        <!-- The map is the home screen of the hub; settings open from it (or a long-press on the bar). -->
        <activity
            android:name=".MapActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ZMD Car as the screen's home app (launcher). A separate, invisible home screen that
             brings up the map in its own normal task: Android never puts a home task into split
             screen, so the map itself must not be the home activity.
             2026-11-18: the HOME category is OFF. Android screens refused to install ZMD Car while
             it declared itself a home app; the copy that installed (made in another Claude chat,
             ZMD-Car-3.7-BYD.apk) differs from ours only by this line and a fresh signing key.
             The real cause turned out to be the accessibility service (see HubA11yService below);
             the "full" build (src/full/AndroidManifest.xml) adds HOME back for installs over adb. -->
        <activity
            android:name=".HomeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity="com.zmd.carhub.home"
            android:theme="@style/HubHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".AppPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.zmd.carhub.picker"
            android:theme="@style/HubDialog" />

        <activity
            android:name=".StoreActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/HubDialog" />

        <activity
            android:name=".AppsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name=".HubService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Car hub: detects phones by USB/Bluetooth and opens CarPlay / Android Auto" />
        </service>

        <!-- The accessibility helper (HubA11yService: split screen, which app is on screen, the side
             bar beside other apps) is declared ONLY in the "full" build, in src/full/AndroidManifest.xml.
             2026-11-18: Play Protect's fraud protection blocks every install from a file manager,
             browser or chat app when the APK declares an accessibility service ("App blocked to
             protect your device", Finsky response=11 in the car's log). So:
               assembleRelease = the build people install by hand (no accessibility, no HOME);
               assembleFull    = everything, installed from the PC over adb only.
             The app checks at run time whether the service is declared (Perms.hasA11yService). -->

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BtReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.zmd.carhub.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
