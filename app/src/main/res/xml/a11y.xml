<?xml version="1.0" encoding="utf-8"?>
<!-- Window-change events (which app is on screen), the window LIST (to tell if the screen is split),
     the split-screen global action, and tapping «Allow» on the system USB prompt when CarPlay
     (DiPlay) asks for the plugged-in iPhone. canRetrieveWindowContent is needed for the window list
     and that one prompt; no other window's text is read (see HubA11yService.kt). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_desc"
    android:notificationTimeout="100" />
